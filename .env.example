# ContentForge AI — Environment Variables (Neon.tech + NextAuth.js)

## REQUIRED

# Neon.tech PostgreSQL (free)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# NextAuth.js (AUTH_SECRET — generate via: openssl rand -base64 32)
AUTH_SECRET=your-generated-secret-here
AUTH_URL=https://yourdomain.vercel.app

# Google OAuth (for "Continue with Google") — optional but recommended
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Paddle Billing (Payments)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token
PADDLE_API_KEY=test_your_paddle_api_key
PADDLE_WEBHOOK_SECRET=your_webhook_secret
PADDLE_ENVIRONMENT=sandbox

# AI — choose ONE
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ContentForge AI
